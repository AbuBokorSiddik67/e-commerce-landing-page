generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  SALE
  CANCELLATION
  RETURN
  RESERVATION
  RELEASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  FAILED_DELIVERY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  COD_PENDING
  COD_COLLECTED
}

enum FinancialStatus {
  UNSETTLED
  PARTIALLY_SETTLED
  SETTLED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  IN_PROGRESS
  SETTLED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponRedemptionStatus {
  VALID
  REDEEMED
  RELEASED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  INSPECTED
  RESTOCKED
  REFUNDED
  COMPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  ACCEPTED
  FAILED
  SKIPPED
}

enum ShipmentStatus {
  PENDING
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  isActive      Boolean         @default(true)
  mustResetPassword Boolean     @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  roles         UserRole[]
  sessions      Session[]
  passwordResets PasswordResetToken[]
  createdProducts Product[]     @relation("ProductCreator")
  createdPages  LandingPage[]   @relation("PageCreator")
  auditLogs     AuditLog[]
  notifications Notification[]
  orders        Order[]         @relation("OrderCreator")
  stockMovements StockMovement[]
  shipments     CourierShipment[]
  refunds       Refund[]
  statusChanges OrderStatusHistory[]
}

model Role {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String?
  isSystem    Boolean     @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime    @default(now())
}

model Permission {
  id          String      @id @default(cuid())
  key         String      @unique
  description String?
  group       String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessSetting {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  description String?
  email       String?
  phone       String?
  address     String?
  logoUrl     String?
  faviconUrl  String?
  currency    String   @default("BDT")
  timezone    String   @default("Asia/Dhaka")
  socialLinks Json     @default("{}")
  deliveryInfo String?
  returnPolicy String?
  privacyPolicy String?
  terms       String?
  brandColor  String   @default("#206a53")
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  parentId     String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  parent       Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([parentId, sortOrder])
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  sku             String?
  shortDescription String?
  description     String?
  regularPrice    Int
  salePrice       Int?
  categoryId      String?
  status          ProductStatus   @default(DRAFT)
  isFeatured      Boolean         @default(false)
  videoUrl        String?
  weightGrams     Int?
  dimensions      Json?
  attributes      Json            @default("[]")
  specifications  Json            @default("[]")
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdById     String?
  createdBy       User?           @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images          ProductImage[]
  variants        ProductVariant[]
  inventoryMovements StockMovement[]
  landingPage     LandingPage?
  orders          Order[]
  coupons         Coupon[]
  reviews         ProductReview[]
  analyticsEvents AnalyticsEvent[]
  returnRequests  ReturnRequest[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@index([status, createdAt])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  kind      String  @default("IMAGE")
  position  Int     @default(0)
  @@index([productId, position])
}

model ProductVariant {
  id               String           @id @default(cuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  sku              String?          @unique
  price            Int?
  compareAtPrice   Int?
  stock            Int              @default(0)
  lowStockThreshold Int             @default(5)
  imageUrl         String?
  attributes       Json             @default("{}")
  isActive         Boolean          @default(true)
  position         Int              @default(0)
  orderItems       OrderItem[]
  movements        StockMovement[]
  reservations     StockReservation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  @@index([productId, position])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  variantId String?
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type      StockMovementType
  quantity  Int
  balanceAfter Int
  reason    String?
  reference String?
  createdById String?
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  @@index([productId, createdAt])
  @@index([variantId, createdAt])
}

model StockReservation {
  id        String          @id @default(cuid())
  variantId String
  orderId   String
  quantity  Int
  expiresAt DateTime
  releasedAt DateTime?
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  @@index([expiresAt])
}

model LandingPage {
  id           String       @id @default(cuid())
  productId    String       @unique
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  slug         String       @unique
  title        String
  status       PageStatus   @default(DRAFT)
  templateCode String       @default("general")
  theme        Json         @default("{}")
  seo          Json         @default("{}")
  analytics    Json         @default("{}")
  settings     Json         @default("{}")
  noIndex      Boolean      @default(false)
  publishedAt  DateTime?
  scheduledFor DateTime?
  createdById  String?
  createdBy    User?        @relation("PageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sections     LandingPageSection[]
  versions     PageVersion[]
  analyticsEvents AnalyticsEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  @@index([status, publishedAt])
}

model LandingPageSection {
  id       String      @id @default(cuid())
  pageId   String
  page     LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type     String
  data     Json        @default("{}")
  enabled  Boolean     @default(true)
  position Int         @default(0)
  @@index([pageId, position])
}

model PageVersion {
  id        String      @id @default(cuid())
  pageId    String
  page      LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  snapshot  Json
  note      String?
  createdAt DateTime    @default(now())
  @@unique([pageId, version])
}

model LandingPageTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  description String?
  sections    Json
  theme       Json
  previewColor String  @default("#206a53")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MediaAsset {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  url         String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  folder      String   @default("General")
  createdAt   DateTime @default(now())
  @@index([folder])
}

model Customer {
  id        String           @id @default(cuid())
  name      String
  phone     String           @unique
  email     String?
  notes     String?
  tags      Json             @default("[]")
  addresses CustomerAddress[]
  orders    Order[]
  reviews   ProductReview[]
  coupons   CouponRedemption[]
  notifications Notification[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@index([name])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  address    String
  district   String
  area       String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Order {
  id                  String              @id @default(cuid())
  orderNumber         String              @unique
  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id])
  productId           String
  product             Product             @relation(fields: [productId], references: [id])
  variantId           String?
  quantity            Int
  subtotal            Int
  deliveryCharge     Int                 @default(0)
  courierFee         Int                 @default(0)
  discount            Int                 @default(0)
  total               Int
  currency            String              @default("BDT")
  status              OrderStatus         @default(PENDING)
  paymentMethod       String              @default("cod")
  paymentStatus       PaymentStatus       @default(PENDING)
  paymentReference    String?
  financialStatus     FinancialStatus     @default(UNSETTLED)
  settlementStatus    SettlementStatus    @default(PENDING)
  deliveryOption      String              @default("inside_city")
  deliveryChargeRuleId String?
  address             String
  district            String
  area                String?
  customerNote        String?
  internalNote        String?
  couponCode          String?
  trackingToken       String              @unique
  ip                  String?
  userAgent           String?
  source              String              @default("landing_page")
  confirmedAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  expectedDeliveryAt  DateTime?
  codCollectedAt      DateTime?
  codSettledAt        DateTime?
  createdById         String?
  createdBy           User?               @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  reservations        StockReservation[]
  payments            PaymentTransaction[]
  paymentAttempts     PaymentAttempt[]
  refunds             Refund[]
  shipments           CourierShipment[]
  returns             ReturnRequest[]
  redemptions         CouponRedemption[]
  reviews             ProductReview[]
  analyticsEvents     AnalyticsEvent[]
  notifications       Notification[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([productId, createdAt])
  @@index([paymentMethod, createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  sku       String?
  unitPrice Int
  quantity  Int
  lineTotal Int
  attributes Json          @default("{}")
  imageUrl  String?
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  source      String      @default("MANUAL")
  note        String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  @@index([orderId, createdAt])
}

model PaymentMethodConfiguration {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  enabled       Boolean  @default(false)
  visible       Boolean  @default(false)
  sandbox       Boolean  @default(true)
  isDefault     Boolean  @default(false)
  credentials   Json     @default("{}")
  status        String   @default("unconfigured")
  lastTestedAt  DateTime?
  lastError     String?
  sortOrder     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model PaymentTransaction {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     String
  reference    String?
  status       String        @default("INITIATED")
  amount       Int
  currency     String        @default("BDT")
  sandbox      Boolean       @default(true)
  checkoutUrl  String?
  payload      Json          @default("{}")
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  refunds      Refund[]
  @@unique([provider, reference])
  @@index([orderId, createdAt])
}

model PaymentAttempt {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  status     String
  response   Json     @default("{}")
  createdAt  DateTime @default(now())
  @@index([orderId, createdAt])
}

model Refund {
  id               String             @id @default(cuid())
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId    String?
  transaction      PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount           Int
  reason           String
  status           String             @default("RECORDED")
  providerReference String?
  mode             String             @default("INTERNAL")
  createdById      String?
  createdBy        User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
}

model CourierProviderConfiguration {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  enabled      Boolean  @default(false)
  visible      Boolean  @default(false)
  sandbox      Boolean  @default(true)
  isDefault    Boolean  @default(false)
  credentials  Json     @default("{}")
  settings     Json     @default("{}")
  status       String   @default("unconfigured")
  lastTestedAt DateTime?
  lastError    String?
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model CourierShipment {
  id             String                @id @default(cuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerCode   String
  consignmentId  String?
  trackingId     String?
  status         ShipmentStatus        @default(PENDING)
  cost           Int                   @default(0)
  codAmount      Int                   @default(0)
  trackingUrl    String?
  labelUrl       String?
  payload        Json                  @default("{}")
  createdById    String?
  createdBy      User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  trackingEvents CourierTrackingEvent[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  @@index([orderId])
  @@index([trackingId])
}

model CourierTrackingEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    CourierShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  description String?
  location    String?
  eventAt     DateTime       @default(now())
  source      String         @default("MANUAL")
  raw         Json           @default("{}")
}

model DeliveryRule {
  id          String  @id @default(cuid())
  name        String
  type        String  @default("district")
  matchValue  String
  charge      Int
  freeAbove   Int?
  isActive    Boolean @default(true)
  priority    Int     @default(0)
  createdAt   DateTime @default(now())
}

model Coupon {
  id             String              @id @default(cuid())
  code           String              @unique
  type           CouponType
  value          Int
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  minOrderValue  Int                 @default(0)
  maxDiscount    Int?
  usageLimit     Int?
  usedCount      Int                 @default(0)
  firstOrderOnly Boolean             @default(false)
  expiresAt      DateTime?
  startsAt       DateTime?
  isActive       Boolean             @default(true)
  redemptions    CouponRedemption[]
  createdAt      DateTime            @default(now())
  @@index([code, isActive])
}

model CouponRedemption {
  id         String                @id @default(cuid())
  couponId   String
  customerId String?
  orderId    String
  status     CouponRedemptionStatus @default(VALID)
  createdAt  DateTime              @default(now())
  coupon     Coupon                @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer   Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([couponId, orderId])
}

model ReturnRequest {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  reason         String
  details        String?
  status         ReturnStatus @default(REQUESTED)
  restock        Boolean      @default(true)
  inspectionNote String?
  refundAmount   Int          @default(0)
  returnCharge   Int          @default(0)
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([status, createdAt])
}

model ProductReview {
  id              String       @id @default(cuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName    String
  rating          Int
  title           String?
  body            String
  status          ReviewStatus @default(PENDING)
  verifiedPurchase Boolean     @default(false)
  createdAt       DateTime     @default(now())
  @@index([productId, status])
}

model Notification {
  id          String              @id @default(cuid())
  userId      String?
  customerId  String?
  orderId     String?
  type        String
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String
  status      NotificationStatus  @default(PENDING)
  readAt      DateTime?
  metadata    Json                @default("{}")
  createdAt   DateTime            @default(now())
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  logs        NotificationLog[]
  @@index([userId, readAt])
  @@index([createdAt])
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  provider       String
  recipient      String
  response       String?
  error          String?
  status         NotificationStatus
  createdAt      DateTime     @default(now())
}

model AnalyticsEvent {
  id        String       @id @default(cuid())
  type      String
  pageId    String?
  productId String?
  orderId   String?
  landingPage LandingPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  visitorId String
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())
  @@index([type, createdAt])
  @@index([pageId, visitorId, createdAt])
}

model DailyAnalyticsSummary {
  id            String   @id @default(cuid())
  date          DateTime @unique
  pageViews     Int      @default(0)
  uniqueVisitors Int     @default(0)
  ctaClicks     Int      @default(0)
  orders        Int      @default(0)
  revenue       Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Integration {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  status    String   @default("disabled")
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id         String    @id @default(cuid())
  provider   String
  eventId    String
  payload    Json      @default("{}")
  processedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  @@unique([provider, eventId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}
