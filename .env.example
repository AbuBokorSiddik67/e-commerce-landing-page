# Core: local PostgreSQL. Change the password and URL before use.
# Docker Compose overrides DATABASE_URL with its private db hostname.
DATABASE_URL="postgresql://landiq:change-me@127.0.0.1:5432/landiq"
# Public origin only, without a path. This value is baked in during next build.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_ENV="development"
# Do not expose reset links on a network-accessible development server.
# LANDIQ_SHOW_DEV_RESET_LINK="1"  # optional, isolated loopback-only development

# Docker Compose only: generate a long random hexadecimal password.
POSTGRES_PASSWORD=""
# Keep this stable and secret. Production requires at least 32 random bytes.
CREDENTIALS_ENCRYPTION_KEY=""

# One-time seed of a NEW, EMPTY database only. Remove credentials after seeding.
# Use at least 16 characters and at most 72 UTF-8 bytes for bcrypt.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_INCLUDE_DEMO="false"

# Optional: S3-compatible object storage; otherwise local storage/uploads.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Optional e-mail (SMTP). Notifications are logged as skipped when unset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional SMS gateway: POST JSON {to,text} with bearer token.
SMS_API_URL=""
SMS_API_TOKEN=""

# Provider credentials are normally entered in the dashboard and encrypted.
# Environment fallbacks, if used, must also be kept secret.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
STEADFAST_API_KEY=""
STEADFAST_API_SECRET=""
REDX_API_KEY=""
