# Core
DATABASE_URL="postgresql://landiq:landiq@localhost:5432/landiq?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_ENV="development"

# Required in production: 32+ byte random key used to encrypt provider credentials
CREDENTIALS_ENCRYPTION_KEY=""

# Optional: S3-compatible object storage (local disk is used when unset)
STORAGE_DRIVER="local" # local | s3
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Optional e-mail (SMTP). Notifications are logged as skipped when unset.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional SMS gateway: POST JSON {to,text} with bearer token
SMS_API_URL=""
SMS_API_TOKEN=""

# Optional Redis-compatible rate limiter endpoint (future multi-instance use)
REDIS_URL=""

# Payment credentials are managed per-provider in the dashboard (encrypted at rest).
# Fill these only when merchant accounts have been approved.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

# Courier credentials are managed per-provider in the dashboard (encrypted at rest).
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
STEADFAST_API_KEY=""
STEADFAST_API_SECRET=""
REDX_API_KEY=""
